# =============================================================================
# Text2Quiz — .gitignore
# =============================================================================

# 1. Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.so
.Python
venv/
.venv/
env/
ENV/
build/
dist/
*.egg-info/

# 2. Node.js & Frontend Build
node_modules/
frontend/node_modules/
frontend/dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 3. Intermediate Caches & Temporary Artifacts
# (แคชขนาดใหญ่จากการ parse spaCy ไม่จำเป็นต้องอัพขึ้น git เพราะโมเดลสร้างใหม่ได้อัตโนมัติ)
*.pkl
backend/artifacts/*.pkl
backend/artifacts/cache.pkl
backend/artifacts/cache_quick.pkl

# หมายเหตุ: หากไม่ต้องการอัพไฟล์ weights โมเดลขนาดใหญ่ขึ้น GitHub (กรณีเทรน Full Dataset ขนาด > 100MB)
# ให้เอาเครื่องหมาย # หน้าบรรทัดด้านล่างนี้ออก:
# backend/artifacts/*.joblib
# backend/artifacts/*.pt

# 4. Environment Variables & Secret Keys
.env
.env.local
.env.*.local

# 5. OS & Editor Specific
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
